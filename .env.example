# Example environment for local development. Copy to .env:
#
#   cp .env.example .env
#   make dev-setup   # writes .env.local: database URL and SSO client
#   make run
#
# make run loads .env, then .env.local. Every value here is a throwaway
# example, not a real credential.

# --- Runtime ---
CALBOOKER_ENV=development
CALBOOKER_SESSION_COOKIE_SECURE=false
CALBOOKER_SESSION_LIFETIME=8h

# --- Retention ---
CALBOOKER_GUEST_RETENTION=720h
CALBOOKER_USAGE_RETENTION=2160h

# --- Mail (optional in development; required in production) ---
# Without either setting, development keeps mail in memory. To read messages
# locally, point it at goweb's Mailpit (make db-up in goweb):
# CALBOOKER_MAIL_RELAY=smtp://localhost:1025
# Or deliver through the Resend HTTP API (set only one of the two):
# CALBOOKER_RESEND_API_KEY=re_...
# CALBOOKER_MAIL_FROM=no-reply@example.test

# --- Optional ---
# Trusted reverse proxy, so rate limits and audit records use X-Forwarded-For.
# CALBOOKER_TRUSTED_PROXY=127.0.0.1

# --- Secrets ---
# At least 32 characters. Generate with: openssl rand -hex 32
CALBOOKER_SESSION_SECRET=dev-only-session-secret-change-me-0123456789

# --- Written by make dev-setup into .env.local, do not set here ---
# CALBOOKER_HTTP_ADDR=127.0.0.1:8082
# CALBOOKER_PUBLIC_URL=http://127.0.0.1:8082
# CALBOOKER_DATABASE_URL=postgres://goweb:...@localhost:55432/calbooker?sslmode=disable
# CALBOOKER_SSO_ISSUER_URL=http://127.0.0.1:4444
# CALBOOKER_SSO_CLIENT_ID=calbooker-dev
# CALBOOKER_SSO_CLIENT_SECRET=...
# CALBOOKER_SSO_ACCOUNT_URL=http://localhost:8080/en/account/settings
# CALBOOKER_BROWSER_PROVIDER_URL=http://localhost:8080
# CALBOOKER_BROWSER_CLIENT_NAME='Calbooker (development)'
