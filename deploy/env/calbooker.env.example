# Settings for deploy/run-calbooker.sh. Copy to a private location (mode 600)
# and fill in the CHANGE_ME values. Get the client ID and secret from
# deploy/register-client.sh. Keep the real file out of Git.
CALBOOKER_ENV=production

# Loopback only, on a port no other app on this host uses.
CALBOOKER_HTTP_ADDR=127.0.0.1:28090
CALBOOKER_PUBLIC_URL=https://calbooker.example.com
CALBOOKER_SESSION_COOKIE_SECURE=true
CALBOOKER_TRUSTED_PROXY=127.0.0.1

# Calbooker's own database and role.
CALBOOKER_DATABASE_URL=postgres://calbooker:CHANGE_ME@127.0.0.1:5432/calbooker?sslmode=disable
CALBOOKER_SESSION_SECRET=CHANGE_ME
# Short, because a session that missed a back-channel logout (calbooker was
# down) stays valid until it expires.
CALBOOKER_SESSION_LIFETIME=8h

# From deploy/register-client.sh.
CALBOOKER_SSO_CLIENT_ID=calbooker
CALBOOKER_SSO_CLIENT_SECRET=CHANGE_ME
# Hydra's public address, and the provider's account page calbooker links to.
CALBOOKER_SSO_ISSUER_URL=https://sso.example.com
CALBOOKER_SSO_ACCOUNT_URL=https://auth.example.com/en/account/settings

# Mail through the Resend API; production requires a mail setting. The sender
# must be on a domain verified in Resend.
CALBOOKER_RESEND_API_KEY=CHANGE_ME
CALBOOKER_MAIL_FROM=no-reply@example.com
